      "name": "qurtuba-fashion",
      "version": "1.0.0",
      "description": "نظام إدارة الأزياء والتطريز - أزياء قرطبة",
      "author": "Qurtuba Fashion Team",
      "private": true,
      "dependencies": {
            "@radix-ui/react-accordion": "^1.2.3",
            "@radix-ui/react-alert-dialog": "^1.1.6",
            "@radix-ui/react-aspect-ratio": "^1.1.2",
