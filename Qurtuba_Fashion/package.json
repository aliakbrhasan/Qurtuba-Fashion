            "@radix-ui/react-label": "^2.1.2",
            "@radix-ui/react-menubar": "^1.1.6",
            "@radix-ui/react-navigation-menu": "^1.2.5",
            "@radix-ui/react-popover": "^1.1.6",
            "@radix-ui/react-progress": "^1.1.2",
            "@radix-ui/react-radio-group": "^1.2.3",
            "@radix-ui/react-scroll-area": "^1.2.3",
            "@radix-ui/react-select": "^2.1.6",
            "@radix-ui/react-separator": "^1.1.2",
            "@radix-ui/react-slider": "^1.2.3",
            "@radix-ui/react-slot": "^1.1.2",
            "@radix-ui/react-switch": "^1.1.3",
            "@radix-ui/react-tabs": "^1.1.3",
            "@radix-ui/react-toggle": "^1.1.2",
            "@radix-ui/react-toggle-group": "^1.1.2",
            "@radix-ui/react-tooltip": "^1.1.8",
            "@supabase/supabase-js": "^2.57.4",
            "@tanstack/react-query": "^5.89.0",
            "better-sqlite3": "^12.4.1",
            "class-variance-authority": "^0.7.1",
            "clsx": "^2.1.1",
            "cmdk": "^1.1.1",
            "dexie": "^4.0.8",
            "dotenv": "^17.2.3",
            "embla-carousel-react": "^8.6.0",
            "input-otp": "^1.4.2",
            "lucide-react": "^0.487.0",
            "next-themes": "^0.4.6",
            "react": "^18.3.1",
            "react-day-picker": "^8.10.1",
            "react-dom": "^18.3.1",
            "react-hook-form": "^7.55.0",
            "react-resizable-panels": "^2.1.7",
            "recharts": "^2.15.2",
            "sonner": "^2.0.3",
            "tailwind-merge": "^2.5.2",
            "uuid": "^9.0.1",
            "vaul": "^1.1.2"
      },
      "devDependencies": {
            "@testing-library/jest-dom": "^6.9.1",
            "@testing-library/react": "^16.3.0",
            "@testing-library/user-event": "^14.6.1",
            "@types/better-sqlite3": "^7.6.13",
            "@types/node": "^20.10.0",
            "@types/react": "^19.1.16",
            "@types/react-dom": "^19.1.9",
            "@types/uuid": "^9.0.7",
            "@vitejs/plugin-react-swc": "^3.10.2",
            "concurrently": "^8.2.2",
            "electron": "^32.0.0",
            "electron-builder": "^24.13.3",
            "javascript-obfuscator": "^4.1.0",
            "jsdom": "^27.0.0",
            "serve": "^14.2.4",
            "terser": "^5.36.0",
            "typescript": "^5.6.3",
            "vite": "6.3.5",
            "vitest": "^3.2.4",
            "wait-on": "^7.2.0"
      },
      "scripts": {
            "dev": "vite",
            "build": "vite build && node scripts/setup-assets.js",
            "build:secure": "vite build --mode production && node scripts/setup-assets.js && node scripts/obfuscate-build.js",
            "build:client": "npm run build:secure",
            "build:electron": "tsc -p electron/tsconfig.json",
            "electron:build:secure": "npm run build:secure && npm run build:electron && electron-builder",
            "test": "vitest",
            "test:ui": "vitest --ui",
            "test:customers": "vitest src/tests/CustomersPage.test.tsx src/tests/CustomersPagePerformance.test.tsx src/tests/CustomersPageIntegration.test.tsx",
            "test:customers:unit": "vitest src/tests/CustomersPage.test.tsx",
            "test:customers:performance": "vitest src/tests/CustomersPagePerformance.test.tsx",
            "test:customers:integration": "vitest src/tests/CustomersPageIntegration.test.tsx",
            "test:customers:coverage": "vitest src/tests/CustomersPage.test.tsx src/tests/CustomersPagePerformance.test.tsx src/tests/CustomersPageIntegration.test.tsx --coverage",
            "lint": "eslint src --ext .ts,.tsx",
            "lint:fix": "eslint src --ext .ts,.tsx --fix",
            "typecheck": "tsc --noEmit",
            "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
            "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && (npx tsc -p electron/tsconfig.json && npm run rebuild:electron && electron dist-electron/main.js)\"",
            "postinstall": "electron-builder install-app-deps",
            "electron:build": "npm run build && npm run build:electron && electron-builder",
            "electron:build:win": "npm run build && npm run build:electron && electron-builder --win nsis",
            "electron:build:mac": "npm run build && electron-builder --mac",
            "electron:build:linux": "npm run build && electron-builder --linux",
            "electron:pack": "npm run build && npm run build:electron && electron-builder --dir",
            "dist:win": "npm run build && npm run build:electron && electron-builder --win nsis",
            "electron:build:simple": "node build-electron-simple.js",
            "electron:dev:simple": "concurrently \"npm run dev\" \"wait-on http://localhost:3001 && electron dist-electron/main.js\"",
            "fix:electron": "fix-electron-complete.bat",
            "fix:electron-better": "fix-with-better-sqlite3.bat",
            "fix:sqlite3": "fix-sqlite3-electron.bat"
      },
      "main": "dist-electron/main.js"
}
